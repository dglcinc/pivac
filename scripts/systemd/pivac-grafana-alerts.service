[Unit]
Description=Pivac Grafana alert state -> Signal K notifications
After=network.target signalk.service grafana-server.service
Requires=signalk.service

[Service]
Type=simple
User=pi
Environment=PIVAC_CFG=/etc/pivac/config.yml
ExecStart=/home/pi/pivac-venv/bin/python3 /home/pi/github/pivac/scripts/pivac-provider.py pivac.GrafanaAlerts --loglevel WARNING --daemon
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
